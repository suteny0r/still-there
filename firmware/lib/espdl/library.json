{
  "name": "espdl",
  "version": "3.3.11",
  "description": "esp-dl 3.3.11 subset (ESP32-S3: xtensa + TIE-728 kernels, detect + image) built as a PlatformIO library",
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": "espressif32",
  "build": {
    "srcDir": ".",
    "srcFilter": [
      "+<dl/tool/src/*>", "+<dl/tensor/src/*>", "+<dl/base/*.cpp>", "+<dl/math/src/*>",
      "+<dl/model/src/*>", "+<dl/module/src/*>",
      "+<dl/tool/isa/xtensa/*>", "+<dl/tool/isa/tie728/*>",
      "+<dl/base/isa/xtensa/*>", "+<dl/base/isa/tie728/*>",
      "+<fbs_loader/src/*>",
      "+<vision/detect/*>", "+<vision/image/*.cpp>"
    ],
    "flags": [
      "-O3", "-ffast-math",
      "-Wno-array-bounds", "-Wno-deprecated-copy", "-Wno-strict-aliasing", "-Wno-overloaded-virtual",
      "-Wno-format", "-Wno-unused-variable", "-Wno-unused-but-set-variable", "-Wno-maybe-uninitialized"
    ],
    "libArchive": true
  }
}
